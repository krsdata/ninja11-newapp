<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ninja.cricks"
    tools:ignore="LockedOrientationActivity">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:name="ninja.cricks.SportsFightApplication"
        android:theme="@style/AppTheme_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:icon,android:theme"
        tools:ignore="GoogleAppIndexingWarning,MissingDefaultResource"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name="ninja.cricks.SplashScreenActivity"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
          >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>
        </activity>

        <activity
            android:name="ninja.cricks.ui.login.LoginScreenActivity"
            android:label="@string/screen_name_login"
            android:screenOrientation="portrait"
            android:configChanges=
                "keyboard|keyboardHidden|screenLayout|screenSize|orientation"
           >
<!--            <intent-filter android:label="deeplink">-->
<!--                      <action android:name="android.intent.action.VIEW"/>-->
<!--                     <category android:name="android.intent.category.BROWSABLE"/>-->
<!--                     <category android:name="android.intent.category.DEFAULT"/>-->
<!--                  <data android:scheme="https" android:host="www.ninja.in" android:pathPrefix="/apks"/>-->
<!--            </intent-filter>-->

        </activity>
        <activity
            android:name="ninja.cricks.ui.login.RegisterScreenActivity"
            android:label="@string/screen_name_register"
            android:screenOrientation="portrait"
            android:configChanges=
                "keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            />
        <activity
            android:name="ninja.cricks.MainActivity"
            android:theme="@style/dashboard_theme"
            android:screenOrientation="portrait"
            />

        <activity
            android:name="ninja.cricks.ContestActivity"
            android:label="@string/activity_type_contest"
            android:screenOrientation="portrait"
            />
        <activity
            android:name="ninja.cricks.MaintainanceActivity"
            android:label="@string/activity_type_contest"
            android:screenOrientation="portrait"
            />

        <activity
            android:name="ninja.cricks.QuizContestActivity"
            android:label="@string/activity_type_contest"
            android:screenOrientation="portrait"
            />
        <activity
            android:name="ninja.cricks.CreateTeamActivity"
            android:label="@string/activity_type_create_team"
            android:screenOrientation="portrait"
            />
        <activity
            android:name="ninja.cricks.TeamPreviewActivity"
            android:label=""
            android:screenOrientation="portrait"
            />

        <activity
            android:name="ninja.cricks.NotificationListActivity"
            android:label=""
            android:screenOrientation="portrait"
            />

        <activity
            android:name="ninja.cricks.SaveTeamActivity"
            android:label=""
            android:screenOrientation="portrait"
            />

        <activity
            android:name="ninja.cricks.SelectTeamActivity"
