<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="@dimen/matches_view_top_margin"
    android:orientation="vertical"
    android:background="@color/light_grey_bg_opac">
    <TextView
        android:id="@+id/contest_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mega Contest"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginLeft="@dimen/matches_view_left_margin_consolidated"
        android:layout_marginRight="@dimen/matches_view_right_margin"
        android:textColor="@color/black"
        android:textSize="@dimen/header_size" />

    <TextView
        android:id="@+id/contest_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get ready for mega winning!!"
        android:fontFamily="@font/open_sans_light"
        android:layout_marginLeft="@dimen/matches_view_left_margin_consolidated"
        android:layout_marginRight="@dimen/matches_view_right_margin"
        android:textColor="@color/black"
        android:textSize="@dimen/small_info_size" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_all_contest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/more_contest_click"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="More Contest"
        android:layout_gravity="right"
        android:layout_marginTop="10dp"
        android:textColor="@color/blue"
        android:paddingRight="10dp"
        android:fontFamily="@font/montserrat_bold"
        />




</LinearLayout>