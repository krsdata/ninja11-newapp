<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

 <RelativeLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/grey_lighter_dense" >
     <androidx.core.widget.NestedScrollView
         android:layout_width="match_parent"
         android:layout_height="match_parent">

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:orientation="vertical"
             android:paddingLeft="16dp"
             android:paddingRight="16dp">

             <androidx.cardview.widget.CardView
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="15dp"
                 app:cardBackgroundColor="#ffffff"

                 >
                 <RelativeLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:padding="16dp">

                     <ImageView
                         android:id="@+id/ruppe_icon"
                         android:layout_width="@dimen/_20sdp"
                         android:layout_height="@dimen/_35sdp"
                         android:layout_centerVertical="true"
                         android:src="@drawable/ic_my_account_add_cash"
                         android:tint="@color/colorAccent"
                         />
                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical"
                         android:layout_toRightOf="@+id/ruppe_icon"
                         android:layout_toLeftOf="@+id/btn_add_cash"
                         android:layout_marginLeft="20dp">
                         <TextView
                             android:id="@+id/added_amount"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="₹0.0"
                             android:textSize="16sp"
                             android:textColor="@color/black"
                             android:fontFamily="@font/open_sans_semibold"
                             />
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="My Deposit"
                             android:textSize="10sp"
                             android:textColor="@color/black"
                             android:fontFamily="@font/open_sans_light"
                             />

                     </LinearLayout>

                     <LinearLayout android:gravity="center_vertical"
                         android:id="@+id/btn_add_cash"
                         android:background="@drawable/add_cash_button"
                         android:layout_width="80dp"
                         android:layout_height="32dp"
                         android:layout_alignParentRight="true"
                         android:layout_centerVertical="true">
                         <TextView android:textSize="12sp"
                             android:textColor="@color/colorAccent"
                             android:gravity="center"
                             android:layout_width="match_parent"
                             android:layout_height="match_parent"
                             android:text="Add Cash"
                             android:lineSpacingExtra="5sp" />
                     </LinearLayout>
                 </RelativeLayout>
             </androidx.cardview.widget.CardView>


             <androidx.cardview.widget.CardView
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 app:cardBackgroundColor="#ffffff"
                 android:layout_marginTop="15dp"

                 >

                 <RelativeLayout
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:padding="16dp">

                     <ImageView
                         android:id="@+id/trophy_icon"
                         android:layout_width="@dimen/_20sdp"
                         android:layout_height="@dimen/_35sdp"
                         android:layout_centerVertical="true"
                         android:src="@drawable/ic_my_account_withdrawal"
                         android:tint="@color/colorAccent" />

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginLeft="20dp"
                         android:layout_toLeftOf="@+id/btn_withdraw"
                         android:layout_toRightOf="@+id/trophy_icon"
                         android:orientation="vertical">

                         <TextView
                             android:id="@+id/winning_amount"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:fontFamily="@font/open_sans_semibold"
                             android:text="₹0.0"
                             android:textColor="@color/black"
                             android:textSize="16sp"
                             />

                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:fontFamily="@font/open_sans_light"
                             android:text="Your Winnings"
                             android:textColor="@color/black"
                             android:textSize="10sp" />

                     </LinearLayout>

                     <LinearLayout
                         android:id="@+id/btn_withdraw"
                         android:layout_width="80dp"
                         android:layout_height="32dp"
                         android:layout_alignParentRight="true"
                         android:layout_centerVertical="true"
                         android:background="@drawable/add_cash_button"
                         android:gravity="center_vertical">

                         <TextView
                             android:layout_width="match_parent"
                             android:layout_height="match_parent"
                             android:gravity="center"
                             android:text="Withdraw"
                             android:textColor="@color/colorAccent"
                             android:textSize="12sp" />
                     </LinearLayout>
                 </RelativeLayout>
             </androidx.cardview.widget.CardView>

             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:layout_marginTop="15dp"
                 >

                 <androidx.cardview.widget.CardView
                     android:layout_width="0dp"
                     android:layout_weight="1"
                     android:layout_height="wrap_content"
                     app:cardBackgroundColor="#ffffff"
                     >
                     <RelativeLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:padding="10dp"
                         >

                         <ImageView
                             android:id="@+id/bonus_icon"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_centerVertical="true"
                             android:layout_alignParentLeft="true"
                             android:src="@drawable/ic_my_account_cash_bonous"
                             android:tint="@color/colorAccent"
                             />
                         <LinearLayout
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:orientation="vertical"
                             android:layout_toRightOf="@+id/bonus_icon"
                             android:layout_centerVertical="true"
                             android:layout_marginLeft="10dp">
                             <TextView
                                 android:id="@+id/cash_bonus"
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="₹0.0"
                                 android:textSize="16sp"
                                 android:singleLine="true"
                                 android:maxLines="1"
                                 android:textColor="@color/black"
                                 android:lineSpacingExtra="6sp"
                                 android:fontFamily="@font/open_sans_semibold"
                                 />
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="Cash Bonus"
                                 android:textSize="10sp"
                                 android:textColor="@color/black"
                                 android:lineSpacingExtra="7sp"
                                 android:fontFamily="@font/open_sans_light"
                                 />

                         </LinearLayout>

                     </RelativeLayout>
                 </androidx.cardview.widget.CardView>


                 <androidx.cardview.widget.CardView
                     android:layout_width="0dp"
                     android:layout_weight="1"
                     android:layout_height="wrap_content"
                     app:cardBackgroundColor="#ffffff"
                     android:layout_marginLeft="20dp"

                     >
                     <RelativeLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:padding="10dp">

                         <ImageView
                             android:id="@+id/wallet_icon"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_centerVertical="true"
                             android:src="@drawable/ic_my_account_wallet"
                             android:layout_alignParentLeft="true"
                             android:tint="@color/colorAccent"
                             />
                         <LinearLayout
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:orientation="vertical"
                             android:layout_toRightOf="@+id/wallet_icon"
                             android:layout_centerVertical="true"
                             android:layout_marginLeft="10dp">
                             <TextView
                                 android:id="@+id/total_balance"
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:text="₹ 0.0"
                                 android:textSize="16sp"
                                 android:singleLine="true"
                                 android:maxLines="1"
                                 android:textColor="@color/black"
                                 android:fontFamily="@font/open_sans_semibold"
                                 />
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="Total Balance"
                                 android:textSize="10sp"
                                 android:textColor="@color/black"
                                 android:fontFamily="@font/open_sans_light"
                                 />

                         </LinearLayout>

                     </RelativeLayout>
                 </androidx.cardview.widget.CardView>

             </LinearLayout>


             <androidx.cardview.widget.CardView
                 android:layout_width="match_parent"
                 android:layout_height="120dp"
                 android:layout_marginTop="15dp"
                 app:cardBackgroundColor="#ffffff">
                 <LinearLayout
                     android:id="@+id/refferal_list"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     >

                     <RelativeLayout
                         android:layout_width="0dp"
                         android:layout_weight="0.6"
                         android:layout_height="match_parent"
                         android:paddingLeft="16dp"
                         android:background="@color/white">

                         <ImageView
                             android:id="@+id/refferal_icon"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_centerVertical="true"
                             android:src="@drawable/ic_wc_black_24dp"
                             android:layout_alignParentLeft="true"
                             android:tint="@color/colorAccent"
                             />
                         <LinearLayout
                             android:layout_width="match_parent"
                             android:layout_height="match_parent"
                             android:orientation="vertical"
                             android:layout_centerVertical="true"
                             android:layout_marginLeft="25dp"
                             android:gravity="center_vertical"
                             >
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="You have Reffered"
                                 android:textSize="14sp"
                                 android:textColor="@color/black"
                                 android:fontFamily="@font/open_sans_semibold"
                                 />
                             <LinearLayout
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:orientation="horizontal">
                                 <TextView
                                     android:id="@+id/friends_counts"
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:text="0"
                                     android:textSize="22sp"
                                     android:textColor="@color/black"
                                     android:fontFamily="@font/open_sans_semibold"
                                     />

                                 <TextView
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:text=" Friends"
                                     android:textSize="11sp"
                                     android:textColor="@color/black"
                                     android:fontFamily="@font/open_sans"
                                     />
                             </LinearLayout>
                             <LinearLayout
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:orientation="horizontal"
                                 android:visibility="gone">
                                 <TextView
                                     android:id="@+id/earning_refferal"
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:text="0"
                                     android:textSize="22sp"
                                     android:textColor="@color/black"
                                     android:fontFamily="@font/open_sans_semibold"
                                     />

                                 <TextView
                                     android:layout_width="wrap_content"
                                     android:layout_height="wrap_content"
                                     android:text=" Earned"
                                     android:textSize="14sp"
                                     android:textColor="@color/black"
                                     android:fontFamily="@font/open_sans"
                                     />
                             </LinearLayout>

                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="Earn and Play Matches"
                                 android:textSize="10sp"
                                 android:textColor="@color/black"
                                 android:fontFamily="@font/open_sans_light"
                                 />

                         </LinearLayout>

                     </RelativeLayout>

                     <View
                         android:layout_width="0dp"
                         android:layout_weight="0.5"
                         android:layout_height="wrap_content"
                         android:background="@drawable/refferal_bg"
                         android:text="YOU REFFER TO"/>
                 </LinearLayout>

             </androidx.cardview.widget.CardView>

         </LinearLayout>

     </androidx.core.widget.NestedScrollView>

     <ProgressBar
         android:id="@+id/progress_bar_playing_history"
         android:layout_width="wrap_content" android:layout_height="wrap_content"
         android:layout_marginLeft="16dp" android:layout_marginRight="16dp"
         android:indeterminate="true" android:layout_centerInParent="true" />
 </RelativeLayout>
</layout>