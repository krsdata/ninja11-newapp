<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="contentviews"
            type="mega.cricks.ChangePasswordActivity" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:background="@color/light_grey_bg">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:fitsSystemWindows="true"
            android:background="?attr/colorPrimary"
            app:theme="@style/ToolbarTheme"
            />


        <ScrollView android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="8dp"
            android:layout_below="@+id/toolbar">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp">
                <RelativeLayout
                    android:layout_width="@dimen/_55sdp"
                    android:layout_height="@dimen/_55sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_centerHorizontal="true">
                    <com.mikhaellopez.circularimageview.CircularImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_profile"
                        android:layout_gravity="center_horizontal"/>
                    <ImageView
                        android:id="@+id/image_edit"
                        android:layout_width="35dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_edit_black_24dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/black"
                        android:layout_alignParentRight="true" />
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.emoji.widget.EmojiEditText
                        android:id="@+id/edit_team_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:hint="Team Name(Nick Name)"
                        android:maxLines="1"
                        android:maxLength="8"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/login_text_size_18sp" />
                </com.google.android.material.textfield.TextInputLayout>


                <TextView android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:lineSpacingExtra="12sp" />

                <EditText
                    android:textSize="12dp"
                    android:textColor="#828282"
                    android:id="@+id/update_profile_name"
                    android:background="@drawable/grey_border"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:inputType="textCapCharacters"/>

                <TextView android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Email"
                    android:lineSpacingExtra="12sp" />
                <EditText
                    android:textSize="12dp"
                    android:textColor="#828282"
                    android:id="@+id/update_email"
                    android:background="@drawable/grey_border"
                    android:padding="8dp"
                    android:enabled="false"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:inputType="textEmailAddress" />
                <TextView android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mobile"
                    android:lineSpacingExtra="12sp" />
                <LinearLayout android:orientation="horizontal"
                    android:background="@drawable/grey_border"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="8dp"
                    >
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#828282"
                        android:layout_gravity="center"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91"
                        android:lineSpacingExtra="10sp"
                        android:fontFamily="sans-serif" />
                    <View android:background="#cdcdcd"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />
                    <EditText android:textSize="12dp"
                        android:textColor="#828282"
                        android:id="@+id/update_edit_mobile"
                        android:padding="8dp"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="number"/>
                </LinearLayout>

                <TextView
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Gender"
                    android:lineSpacingExtra="12sp" />

                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioGroup android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/gender_group"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <RadioButton
                            android:textColor="#282828"
                            android:id="@+id/gender_male"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Male" />
                        <RadioButton
                            android:textColor="#282828"
                            android:id="@+id/gender_female"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="32dp"
                            android:text="Female" />
                    </RadioGroup>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Date of Birth"
                    android:lineSpacingExtra="12sp" />
                <EditText
                    android:textSize="12dp"
                    android:textColor="#828282"
                    android:id="@+id/date_of_birth"
                    android:background="@drawable/grey_border"
                    android:padding="8dp"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    />
                <TextView
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="City"
                    android:lineSpacingExtra="12sp" />
                <EditText
                    android:textSize="12dp"
                    android:textColor="#828282"
                    android:id="@+id/edit_city"
                    android:background="@drawable/grey_border"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:inputType="text" />
                <TextView
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Pin Code"
                    android:visibility="gone"
                    android:lineSpacingExtra="12sp" />

                <EditText
                    android:textSize="12dp"
                    android:textColor="#828282"
                    android:id="@+id/edit_picode"
                    android:background="@drawable/grey_border"
                    android:padding="8dp" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLength="6"
                    android:visibility="gone"
                    android:inputType="number" />
                <TextView
                    android:textSize="14sp"
                    android:textColor="#282828"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="State"
                    android:visibility="gone"
                    android:lineSpacingExtra="12sp" />
                <Spinner
                    android:entries="@array/india_states"
                    android:id="@+id/spinner_states"
                    android:background="@drawable/grey_border"
                    android:padding="5dp" android:layout_width="match_parent"
                    android:visibility="gone"
                    android:layout_height="40dp" android:layout_marginTop="5dp" />
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btn_update_profile"
                    android:background="@drawable/rounded_corner_filled_blue"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:text="Update Profile"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>



        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_centerInParent="true"
            android:visibility="gone"/>


    </RelativeLayout>


</layout>