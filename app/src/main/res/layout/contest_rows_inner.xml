<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="12dp"
    app:cardCornerRadius="6dp"
    android:layout_marginTop="@dimen/matches_view_top_margin"
    android:layout_marginLeft="@dimen/matches_view_right_margin"
    android:layout_marginRight="@dimen/matches_view_right_margin"
    android:layout_marginBottom="5dp">
    <LinearLayout
        android:id="@+id/linear_trades_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/matches_view_left_margin_inner"
            android:layout_marginRight="@dimen/matches_view_right_margin_inner"
            android:layout_marginTop="3dp"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prize Pool"
                android:textSize="@dimen/small_info_size"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entry"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/black"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/matches_gap_between_each_views"
            >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/contest_prize_pool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹50000"
                    android:textSize="16sp"
                    android:layout_gravity="top"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginLeft="5dip"
                    android:fontFamily="@font/montserrat_bold"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_action_contest"
                        android:gravity="center"
                        android:text="Winner"
                        android:textColor="@color/black"
                        android:fontFamily="@font/montserrat_regular"/>
                    <TextView
                        android:id="@+id/winning_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="10"
                        android:textColor="@color/red"
                        android:textSize="@dimen/_11sdp"
                        android:drawableRight="@drawable/ic_arrow_drop_up_black_24dp"
                        android:layout_marginLeft="@dimen/_3sdp"
                        android:fontFamily="@font/montserrat_medium"/>
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginRight="5dip"
                android:gravity="right">
                <TextView
                    android:id="@+id/contest_entry_prize"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:text="JOIN"
                    android:gravity="center"
                    android:textSize="@dimen/header_size"
                    android:padding="6dp"
                    android:backgroundTint="@color/green"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/default_rounded_button_sportsfight"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_semibold"
                    />


            </LinearLayout>


        </LinearLayout>
        <LinearLayout
            android:id="@+id/upcoming_linear_contest_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/matches_gap_between_each_views"
            android:layout_marginLeft="@dimen/matches_view_left_margin_inner"
            android:layout_marginRight="@dimen/matches_view_right_margin_inner">
            <ProgressBar
                android:id="@+id/contest_progress"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminateOnly="false"
                android:progressDrawable="@drawable/progressbar_inderminate"
                android:max="10"
                android:progress="4"
                android:indeterminateDrawable="@android:drawable/progress_indeterminate_horizontal"
                />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:orientation="horizontal"
                android:layout_marginTop="7dip"
                >
                <TextView
                    android:id="@+id/total_spot_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contest Full"
                    android:textColor="@color/error_color_material_dark"
                    android:textSize="16dp"
                    android:fontFamily="@font/montserrat_medium"/>

                <TextView
                    android:id="@+id/total_spot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50,000 spots"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/error_color_material_dark"
                    android:textSize="13dp"
                    android:fontFamily="@font/montserrat_medium"
                    />

            </RelativeLayout>


        </LinearLayout>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="37dp"
           android:background="@color/grey_lighter_dense"
           android:layout_marginTop="3dip"
           android:gravity="center_vertical"
           android:paddingLeft="@dimen/_7sdp"
           android:paddingRight="@dimen/_7sdp"
           android:orientation="horizontal">
           <LinearLayout
               android:layout_width="0dp"
               android:layout_weight="1"
               android:layout_height="match_parent"
               android:gravity="center_vertical"
               android:orientation="horizontal">

               <ImageView
                   android:layout_width="18dp"
                   android:layout_height="18dp"
                   android:fontFamily="@font/montserrat_bold"
                   android:gravity="center"
                   android:scaleType="centerInside"
                   android:src="@drawable/trophy_first_pos"
                   />
               <TextView
                   android:id="@+id/first_prize"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:text="₹5 Lakh"
                   android:textSize="@dimen/_10sdp"
                   android:textColor="@color/black"
                   android:layout_marginLeft="@dimen/_3sdp"
                   android:fontFamily="@font/montserrat_regular"/>
           </LinearLayout>



           <LinearLayout
               android:layout_width="0dp"
               android:layout_weight="2"
               android:layout_height="match_parent"
               android:gravity="center_vertical|right"
               android:orientation="horizontal"
              >
               <TextView
                   android:id="@+id/contest_cancellation"
                   android:layout_width="23dp"
                   android:layout_height="23dp"
                   android:scaleType="centerInside"
                   android:backgroundTint="@color/colorPrimary"
                   android:background="@drawable/circle_green"
                   android:text="C"
                   android:textColor="@color/white"
                   android:fontFamily="@font/montserrat_regular"
                   android:gravity="center"
                   />
               <LinearLayout
                   android:id="@+id/linear_Multi"
                   android:layout_width="60dp"
                   android:layout_height="23dp"
                   android:orientation="horizontal"
                   android:background="@drawable/rectangle_red"
                   android:layout_marginLeft="10dp">
                   <TextView
                       android:id="@+id/allowedTeamType"
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="match_parent"
                       android:scaleType="centerInside"
                       android:text="M"
                       android:textColor="@color/white"
                       android:gravity="center"
                       />

                   <TextView
                       android:id="@+id/contest_multiplayer"
                       android:layout_width="0dp"
                       android:layout_height="match_parent"
                       android:layout_marginTop="2dp"
                       android:layout_marginBottom="2dp"
                       android:layout_marginRight="2dp"

                       android:layout_weight="1"
                       android:background="@color/white"
                       android:fontFamily="@font/montserrat_regular"
                       android:gravity="center"
                       android:scaleType="centerInside"
                       android:text="1"
                       android:textColor="@color/black"
                       android:textSize="10sp" />

               </LinearLayout>


               <LinearLayout
                   android:id="@+id/linear_bonues"
                   android:layout_width="75dp"
                   android:layout_height="23dp"
                   android:orientation="horizontal"
                   android:background="@drawable/rectangle_orange"
                   android:layout_marginLeft="10dp">
                   <TextView
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="match_parent"
                       android:scaleType="centerInside"
                       android:text="B"
                       android:textColor="@color/white"
                       android:gravity="center"
                       />

                   <TextView
                       android:id="@+id/contest_bonus"
                       android:layout_width="0dp"
                       android:layout_height="match_parent"
                       android:layout_marginTop="2dp"
                       android:layout_marginBottom="2dp"
                       android:layout_marginRight="2dp"

                       android:layout_weight="1"
                       android:background="@color/white"
                       android:fontFamily="@font/montserrat_regular"
                       android:gravity="center"
                       android:scaleType="centerInside"
                       android:text="100%"
                       android:textColor="@color/black"
                       android:textSize="10sp" />

               </LinearLayout>
           </LinearLayout>

       </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
</layout>